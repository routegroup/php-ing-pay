# Credentials for the sandbox run — tests/Sandbox, driven by composer test:sandbox.
# Copy to .env, which is never committed. CI reads the same names from secrets.
ING_PAY_ENV=sandbox
ING_PAY_MERCHANT_ID=
ING_PAY_SERVICE_ID=
ING_PAY_SERVICE_KEY=
ING_PAY_API_KEY=

# Forwards the gateway's notifications to the local catcher. The subdomain has
# to match the notification url configured on the service: the gateway delivers
# to that one address and ignores the notificationUrl carried by a request.
ULTRAHOOK_API_KEY=
ULTRAHOOK_SUBDOMAIN=github
