{
    "name": "routegroup/php-ing-pay",
    "description": "ING Pay payment gateway client for plain PHP",
    "keywords": [
        "routegroup",
        "ing-pay",
        "imoje",
        "payments"
    ],
    "homepage": "https://github.com/routegroup/php-ing-pay",
    "license": "MIT",
    "authors": [
        {
            "name": "Kajetan Nobel",
            "email": "k.nobel@routegroup.pl",
            "role": "Developer"
        }
    ],
    "require": {
        "justinrainbow/json-schema": "^6.10.0",
        "php": "^8.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "guzzlehttp/guzzle": "^7.9||^8.0",
        "laravel/pint": "^1.30.5",
        "nyholm/psr7": "^1.8",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-phpstan": "^5.2",
        "pestphp/pest-plugin-rector": "^5.0",
        "phpstan/phpstan": "^2.1",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1||^2.0",
        "rector/rector": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "Routegroup\\IngPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Routegroup\\IngPay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": [
            "vendor/bin/rector process",
            "vendor/bin/pint"
        ],
        "test:lint": [
            "vendor/bin/rector process --dry-run",
            "vendor/bin/pint --test"
        ],
        "test:types": "vendor/bin/phpstan analyse --memory-limit=1G",
        "test:unit": "vendor/bin/pest --ci --testsuite=core",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ],
        "test:sandbox": "vendor/bin/pest --testsuite=sandbox"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "fakerphp/faker": "Required by the test factories (Payload::factory()); this package does not need it at runtime.",
        "psr/http-client": "Required only by Psr18Client, to drive this package with an HTTP client you already have.",
        "psr/http-factory": "Required only by Psr18Client, alongside psr/http-client.",
        "guzzlehttp/guzzle": "A PSR-18 client that Psr18Client::guzzle() wires up in one line; any other PSR-18 client works too."
    }
}
