{
    "name": "routegroup/php-ing-pay",
    "description": "ING Pay payment gateway client for plain PHP",
    "keywords": [
        "routegroup",
        "ing-pay",
        "imoje",
        "payments"
    ],
    "homepage": "https://github.com/routegroup/php-ing-pay",
    "license": "MIT",
    "authors": [
        {
            "name": "Kajetan Nobel",
            "email": "k.nobel@routegroup.pl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "laravel/pint": "^1.30.5",
        "pestphp/pest": "^5.3.3",
        "pestphp/pest-plugin-phpstan": "^5.2",
        "pestphp/pest-plugin-rector": "^5.0",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "Routegroup\\IngPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Routegroup\\IngPay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": [
            "vendor/bin/rector process",
            "vendor/bin/pint"
        ],
        "test:lint": [
            "vendor/bin/rector process --dry-run",
            "vendor/bin/pint --test"
        ],
        "test:types": "vendor/bin/phpstan analyse --memory-limit=1G",
        "test:unit": "vendor/bin/pest --ci",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
