{
    "name": "routegroup/php-ing-pay",
    "description": "ING Pay payment gateway client for plain PHP",
    "keywords": [
        "routegroup",
        "ing-pay",
        "imoje",
        "payments"
    ],
    "homepage": "https://github.com/routegroup/php-ing-pay",
    "license": "MIT",
    "authors": [
        {
            "name": "Kajetan Nobel",
            "email": "k.nobel@routegroup.pl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "laravel/pint": "^1.30.5",
        "pestphp/pest": "^4.7.8",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Routegroup\\IngPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Routegroup\\IngPay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
